# Optional overrides. Values are server-only.
EPOCH_MAINNET_URL=https://mainnet-api.epochprotocol.xyz
# Optional quote-only EVM sponsor and Miden account IDs (hex).
# No private keys or wallet connection are needed.
# EPOCH_QUOTE_SPONSOR=0x0000000000000000000000000000000000000001
# EPOCH_MAINNET_ACCOUNT=0x...

# Optional build-time path prefix; leave empty for local development.
# NEXT_PUBLIC_BASE_PATH=/epoch

# IPD: fixed, server-only, public read-only mainnet solver origin.
IPD_NETWORK=mainnet
IPD_MAINNET_URL=https://api.forkchoice.xyz
# Expire displayed observations even when automatic refresh is off.
IPD_OBSERVATION_TTL_SECONDS=120
# Reject stale/future Binance construction and valuation timestamps.
IPD_PRICE_MAX_AGE_SECONDS=30
# HTTP loopback origins are accepted only for local deterministic fixtures.
