# Optional overrides. Values are server-only.
EPOCH_MAINNET_URL=https://mainnet-api.epochprotocol.xyz
# Optional quote-only EVM sponsor and Miden account IDs (hex).
# No private keys or wallet connection are needed.
# EPOCH_QUOTE_SPONSOR=0x0000000000000000000000000000000000000001
# EPOCH_MAINNET_ACCOUNT=0x...

# Optional build-time path prefix; leave empty for local development.
# NEXT_PUBLIC_BASE_PATH=/epoch
